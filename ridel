checker_run() {
  local py_bin="$PROJECT_ROOT/backend/.venv/bin/python"
  if [ ! -f "$py_bin" ]; then
    error "Python não encontrado em backend/.venv/bin/python."
    return 1
  fi
  (cd "$PROJECT_ROOT/backend" && "$py_bin" -m ridel check "$@")
}

checker_start() {
  local pid=""
  if [ -f "$PID_DIR/checker.pid" ]; then
    pid=$(cat "$PID_DIR/checker.pid")
  fi
  if is_pid_alive "$pid"; then
    warn "Checker já está em execução em background (PID: $pid)."
    return 0
  fi

  local py_bin="$PROJECT_ROOT/backend/.venv/bin/python"
  if [ ! -f "$py_bin" ]; then
    error "Python não encontrado em backend/.venv/bin/python."
    return 1
  fi

  info "Iniciando Ridel Checker em segundo plano (Watch Mode)..."
  cd "$PROJECT_ROOT/backend"
  local cmd=("$py_bin" "-u" "-m" "ridel" "check" "-w")
  if [ $# -gt 0 ]; then
    cmd+=("$@")
  else
    cmd+=("--all")
  fi

  setsid "${cmd[@]}" < /dev/null > "$LOG_DIR/checker.log" 2>&1 &
  local new_pid=$!
  echo "$new_pid" > "$PID_DIR/checker.pid"

  sleep 1
  if is_pid_alive "$new_pid"; then
    success "Checker rodando em background (PID: $new_pid)."
    info "Logs disponíveis em: .ridel/logs/checker.log (ou execute: ridel check logs)"
  else
    error "Falha ao iniciar o Checker. Verifique o log com: ridel check logs"
    return 1
  fi
}

checker_stop() {
  local pid=""
  if [ -f "$PID_DIR/checker.pid" ]; then
    pid=$(cat "$PID_DIR/checker.pid")
  fi
  if [ -n "$pid" ]; then
    kill_process "Checker" "$pid"
    rm -f "$PID_DIR/checker.pid"
  else
    info "Checker não está em execução."
  fi
}

checker_status() {
  local pid=""
  if [ -f "$PID_DIR/checker.pid" ]; then
    pid=$(cat "$PID_DIR/checker.pid")
  fi
  if is_pid_alive "$pid"; then
    success "Checker: RODANDO (PID: $pid) [Watch Mode]"
    return 0
  else
    warn "Checker: PARADO"
    return 1
  fi
}

checker_logs() {
  if [ ! -f "$LOG_DIR/checker.log" ]; then
    warn "Arquivo de log não encontrado em $LOG_DIR/checker.log"
    return 1
  fi
  tail -f "$LOG_DIR/checker.log"
}


# ------------------------------------------------------------------------------
# Roteamento de Argumentos
# ------------------------------------------------------------------------------

case "$1" in
  db)
    shift
    case "$1" in
      start)   db_start ;;
      stop)    db_stop ;;
      restart) db_restart ;;
      status)  db_status ;;
      logs)    shift; db_logs "$@" ;;
      seed)    shift; db_seed "$@" ;;
      *)       warn "Ação desconhecida para 'db'. Use: start, stop, restart, status, logs, seed"; exit 1 ;;
    esac
    ;;

  backend)
    shift
    case "$1" in
      start)   shift; backend_start "$@" ;;
      stop)    backend_stop ;;
      restart) shift; backend_restart "$@" ;;
      status)  backend_status ;;
      logs)    backend_logs ;;
      *)       warn "Ação desconhecida para 'backend'. Use: start, stop, restart, status, logs"; exit 1 ;;
    esac
    ;;

  frontend)
    shift
    case "$1" in
      start)       shift; frontend_start "$@" ;;
      stop)        frontend_stop ;;
      restart)     shift; frontend_restart "$@" ;;
      reload)      frontend_reload ;;
      hot-restart) frontend_hot_restart ;;
      attach)      shift; frontend_attach "$@" ;;
      release) shift; frontend_release "$@" ;;
      status)      frontend_status ;;
      logs)        frontend_logs ;;
      *)           warn "Ação desconhecida para 'frontend'. Use: start, stop, restart, reload, hot-restart, attach, release, status, logs"; exit 1 ;;
    esac
    ;;

  check)
    shift
    if is_standalone_host; then
      standalone_proxy check "$@"
    else
      case "$1" in
        start)  shift; checker_start "$@" ;;
        stop)   checker_stop ;;
        status) checker_status ;;
        logs)   checker_logs ;;
        *)      checker_run "$@" ;;
      esac
    fi
    ;;

  tenant)
    shift
    if is_standalone_host; then
      standalone_proxy tenant "$@"
    else
      case "$1" in
        create) shift; tenant_create "$@" ;;
        *)      warn "Ação desconhecida para 'tenant'. Use: create <nome>"; exit 1 ;;
      esac
    fi
    ;;

  status)
    if is_standalone_host; then
      standalone_status
    else
      status_all
    fi
    ;;

  start)
    if is_standalone_host; then
      standalone_start "$@"
    else
      start_all
    fi
    ;;

  stop)
    if is_standalone_host; then
      standalone_stop "$@"
    else
      stop_all
    fi
    ;;

  restart)
    if is_standalone_host; then
      standalone_restart "$@"
    else
      restart_all
    fi
    ;;

  reload)
    frontend_reload
    ;;

  hot-restart)
    frontend_hot_restart
    ;;

  attach)
    shift
    frontend_attach "$@"
    ;;

  release)
    shift; frontend_release "$@"
    ;;

  seed)
    shift || true
    if is_standalone_host; then
      standalone_proxy seed "$@"
    else
      db_seed "$@"
    fi
    ;;

  logs)
    shift
    if is_standalone_host; then
      standalone_logs "$@"
    else
      case "$1" in
        db)       shift; db_logs "$@" ;;
        backend)  backend_logs ;;
        frontend) frontend_logs ;;
        checker)  checker_logs ;;
        *)        warn "Especifique o serviço para logs: db [tenant], backend, frontend ou checker"; exit 1 ;;
      esac
    fi
    ;;

  link)
    link_cli
    ;;

  publish)
    if is_standalone_host; then
      error "O comando 'ridel publish' é restrito aos mantenedores da Plataforma Ridel no repositório de engenharia."
      exit 1
    fi
    shift
    docker_publish "$@"
    ;;

  build-image)
    if is_standalone_host; then
      error "O comando 'ridel build-image' é restrito aos mantenedores da Plataforma Ridel no repositório de engenharia."
      exit 1
    fi
    shift
    docker_build_image "$@"
    ;;

  dockertest)
    if is_standalone_host; then
      error "O comando 'ridel dockertest' é restrito aos mantenedores da Plataforma Ridel no repositório de engenharia."
      exit 1
    fi
    shift
    docker_test "$@"
    ;;

  update|att)
    shift
    docker_update "$@"
    ;;

  rollback)
    shift
    docker_rollback "$@"
    ;;

  cli)
    shift
    case "$1" in
      update) shift; cli_self_update "$@" ;;
      *)      warn "Ação desconhecida para 'cli'. Use: update"; exit 1 ;;
    esac
    ;;

  help|--help|-h|"")
    help_menu
    ;;

  *)
    error "Comando não reconhecido: $1"
    help_menu
    exit 1
    ;;
esac

  echo -e "${BOLD}Iniciando todos os serviços da Plataforma Ridel...${NC}"
  db_start
  sleep 1
  backend_start
  sleep 1
  frontend_start
  echo ""
  status_all
}

stop_all() {
  if is_container_env; then
    info "Ambiente Docker detectado: parando serviços via Supervisord..."
    if command -v supervisorctl >/dev/null 2>&1; then
      supervisorctl stop all
    fi
    echo ""
    success "Todos os serviços foram finalizados no Supervisord."
    return 0
  fi
  echo -e "${BOLD}Encerrando todos os serviços da Plataforma Ridel...${NC}"
  checker_stop || true
  frontend_stop
  backend_stop
  db_stop
  echo ""
  success "Todos os serviços foram finalizados."
}

restart_all() {
  if is_container_env; then
    info "Ambiente Docker detectado: reiniciando serviços via Supervisord..."
    if command -v supervisorctl >/dev/null 2>&1; then
      supervisorctl restart all
    fi
    echo ""
    status_all
    return 0
  fi
  echo -e "${BOLD}Reiniciando todos os serviços da Plataforma Ridel...${NC}"
  stop_all
  sleep 2
  start_all
}


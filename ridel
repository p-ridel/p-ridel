start_all() {
  if is_container_env; then
    info "Ambiente Docker detectado: gerenciando serviços via Supervisord..."
    if command -v supervisorctl >/dev/null 2>&1; then
      supervisorctl start all
    fi
    echo ""
    status_all
    return 0

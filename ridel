docker_publish() {
  local version=""
  local custom_registry=""
  local skip_tests=0
  local skip_image=0
  local skip_git=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --skip-tests)
        skip_tests=1
        shift
        ;;
      --skip-image)
        skip_image=1
        shift
        ;;
      --skip-git)
        skip_git=1
        shift
        ;;
      --registry)
        shift
        custom_registry="$1"
        shift
        ;;
      -h|--help)
        echo -e "${BOLD}Uso:${NC} ridel publish [versao] [--registry <custom>] [--skip-tests] [--skip-image] [--skip-git]"
        echo ""
        echo -e "${BOLD}Pipeline de Publicação Dual da Plataforma Ridel:${NC}"
        echo "  1. Quality Gate: Executa testes unitários essenciais do backend (pytest)"
        echo "  2. Universal Player: Compila o Flutter Web em modo release otimizado"
        echo "  3. Imagem Docker: Constrói a imagem All-in-One e envia ao GitHub Container Registry (ghcr.io/p-ridel/p-ridel)"
        echo "  4. Sincronização Dev: Publica o código-fonte integral no repositório privado p-ridel-dev (remote origin)"
        echo "  5. Vitrine do Cliente: Publica apenas a documentação limpa (README.md) no repositório público p-ridel (remote client)"
        echo ""
        echo "Opções:"
        echo "  --skip-tests    Pula a execução dos testes do backend"
        echo "  --skip-image    Pula a compilação do Flutter e o build/push da imagem Docker"
        echo "  --skip-git      Pula as publicações nos repositórios Git (p-ridel-dev e p-ridel)"
        echo "  --registry <url> Sobrescreve o registry de containers (padrão: ghcr.io/p-ridel/p-ridel)"
        echo ""
        echo "Exemplos:"
        echo "  ridel publish"
        echo "  ridel publish 1.0.1"
        echo "  ridel publish v1.0.1 --skip-tests"
        echo "  ridel publish --skip-image"
        return 0
        ;;
      *)
        if [[ -z "$version" && ! "$1" =~ ^-- ]]; then
          version="$1"
        else
          error "Argumento não reconhecido ou versão duplicada: $1"
          return 1
        fi
        shift
        ;;
    esac
  done

  # Versão padrão é 'latest' quando omitida
  if [[ -z "$version" || "$version" == "latest" ]]; then
    version="latest"
  fi

  # Normaliza versão garantindo prefixo 'v' para tags semânticas (ex: 1.0.1 -> v1.0.1)
  # Se for 'latest', não adiciona 'v'
  local tag_version="$version"
  if [[ "$tag_version" != "latest" && "$tag_version" != v* ]]; then
    tag_version="v$tag_version"
  fi

  # Resolver Registry dinamicamente a partir do git remote origin
  local target_registry="$custom_registry"
  local namespace="p-ridel"
  if [[ -z "$target_registry" ]]; then
    if [[ -n "$RIDEL_REGISTRY" ]]; then
      target_registry="$RIDEL_REGISTRY"
    else
      local git_remote
      git_remote=$(git remote get-url origin 2>/dev/null || true)
      if [[ -n "$git_remote" ]]; then
        local repo_slug
        repo_slug=$(echo "$git_remote" | sed -E 's#(.*github\.com[:/])(.*)\.git#\2#' | tr -d '\r')
        namespace=$(echo "$repo_slug" | cut -d/ -f1)
        target_registry="ghcr.io/${namespace}/p-ridel"
      else
        target_registry="ghcr.io/p-ridel/p-ridel"
      fi
    fi
  fi

  echo ""
  echo -e "${BOLD}===================================================================${NC}"
  echo -e "${BOLD}🚀 Plataforma Ridel — Pipeline Dual de Publicação${NC}"
  echo -e "${BOLD}===================================================================${NC}"
  info "Versão de release:   ${BOLD}$tag_version${NC}"
  info "Target Registry:     ${BOLD}$target_registry${NC}"
  info "Repositório Dev:     ${BOLD}p-ridel-dev (remote origin)${NC}"
  info "Repositório Cliente: ${BOLD}p-ridel (remote client)${NC}"
  echo ""

  # 1. Quality Gate: Testes automatizados do Backend
  if [[ "$skip_tests" -eq 0 ]]; then
    info "Executando Quality Gate (testes unitários essenciais do backend)..."
    local py_bin="$PROJECT_ROOT/backend/.venv/bin/pytest"
    if [[ ! -f "$py_bin" ]]; then
      py_bin="pytest"
    fi
    if (cd "$PROJECT_ROOT/backend" && "$py_bin" tests/test_docker_bootstrap.py tests/api/test_cli.py tests/api/test_cli_publish.py -q); then
      success "Quality Gate aprovado com sucesso!"
    else
      error "Falha no Quality Gate! A suíte de testes falhou. Publicação abortada."
      info "Dica: Para forçar a publicação sem testes, utilize a flag: --skip-tests"
      return 1
    fi
  else
    warn "Quality Gate ignorado via flag --skip-tests."
  fi

  # 2 & 3. Compilação Flutter Web e Build/Push da Imagem Docker
  if [[ "$skip_image" -eq 0 ]]; then
    info "Iniciando compilação de produção do Flutter Universal Player Web..."
    (cd "$PROJECT_ROOT/frontend" && flutter build web --release)
    success "Flutter Universal Player Web compilado para produção!"

    local tags_to_build=()
    local tags_to_push=()

    if [[ "$tag_version" == "latest" ]]; then
      local full_tag_latest="${target_registry}:latest"
      tags_to_build+=("-t" "$full_tag_latest")
      tags_to_push+=("$full_tag_latest")
    else
      local full_tag_ver="${target_registry}:${tag_version}"
      local full_tag_latest="${target_registry}:latest"
      tags_to_build+=("-t" "$full_tag_ver" "-t" "$full_tag_latest")
      tags_to_push+=("$full_tag_ver" "$full_tag_latest")
    fi

    info "Construindo imagem Docker All-in-One..."
    docker build "${tags_to_build[@]}" -f "$PROJECT_ROOT/Dockerfile.allinone" "$PROJECT_ROOT"
    success "Imagem Docker construída com sucesso com tags:"
    for t in "${tags_to_push[@]}"; do
      info "  • $t"
    done

    info "Enviando imagens para o registry remoto..."
    for t in "${tags_to_push[@]}"; do
      docker push "$t"
    done

    success "Publicação da imagem concluída no GitHub Container Registry!"
    for t in "${tags_to_push[@]}"; do
      info "  • $t"
    done
    info "Pacote público oficial: https://github.com/users/${namespace}/packages/container/package/p-ridel"
  else
    warn "Compilação e publicação da imagem Docker ignoradas via flag --skip-image."
  fi

  # 4 & 5. Publicação Git Dual
  if [[ "$skip_git" -eq 0 ]]; then
    echo ""
    info "Iniciando sincronização Git nos repositórios p-ridel-dev e p-ridel..."

    local origin_url client_url
    origin_url=$(git remote get-url origin 2>/dev/null | tr -d '\r' || true)
    client_url=$(git remote get-url client 2>/dev/null | tr -d '\r' || true)

    # Normalizar removendo credenciais para comparação segura
    local clean_origin_url clean_client_url
    clean_origin_url=$(echo "$origin_url" | sed -E 's#https://[^@]+@#https://#')
    clean_client_url=$(echo "$client_url" | sed -E 's#https://[^@]+@#https://#')

    if [[ -n "$clean_origin_url" && -n "$clean_client_url" && "$clean_origin_url" == "$clean_client_url" ]]; then
      error "Os remotes 'origin' e 'client' estão apontando para o mesmo repositório ($clean_origin_url)!"
      info "O remote 'origin' deve apontar para o repositório privado p-ridel-dev."
      info "O remote 'client' deve apontar para o repositório público p-ridel."
      info "Exemplo de correção: git remote set-url origin https://github.com/p-ridel/p-ridel-dev.git"
      return 1
    fi

    # 4. Push do projeto completo para p-ridel-dev (remote origin)
    local current_branch
    current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "master")
    if git remote get-url origin >/dev/null 2>&1; then
      info "Sincronizando repositório de desenvolvimento (p-ridel-dev via remote origin)..."
      if git push origin "$current_branch"; then
        success "Repositório privado p-ridel-dev (origin/$current_branch) atualizado com sucesso!"
      else
        error "Falha ao enviar commits para o remote 'origin' (p-ridel-dev)!"
        return 1
      fi
    else
      warn "Remote 'origin' não encontrado. Pulando sincronização do p-ridel-dev."
    fi

    # 5. Publicação da documentação pública exclusiva no repositório do cliente (p-ridel via remote client)
    info "Publicando documentação no repositório público do cliente (p-ridel via remote client)..."
    if ! git remote get-url client >/dev/null 2>&1; then
      warn "Remote 'client' não está configurado!"
      info "Para registrar o remote do cliente e habilitar a documentação pública, execute:"
      info "  git remote add client https://github.com/p-ridel/p-ridel.git"
      warn "Push para o repositório público 'p-ridel' ignorado nesta execução."
    else
      local readme_path="$PROJECT_ROOT/README.md"
      if [[ ! -f "$readme_path" ]]; then
        error "README.md não encontrado na raiz do projeto ($readme_path)!"
        return 1
      fi

      info "Criando commit isolado com a documentação pública oficial (README.md e Manual do Desenvolvedor)..."
      local temp_idx
      temp_idx=$(mktemp)
      rm -f "$temp_idx"

      GIT_INDEX_FILE="$temp_idx" git add "$readme_path"

      local install_path="$PROJECT_ROOT/install.sh"
      if [[ -f "$install_path" ]]; then
        GIT_INDEX_FILE="$temp_idx" git add "$install_path"
      fi

      local ridel_bin_path="$PROJECT_ROOT/ridel"
      if [[ -f "$ridel_bin_path" ]]; then
        GIT_INDEX_FILE="$temp_idx" git add "$ridel_bin_path"
      fi

      local manual_path="$PROJECT_ROOT/docs/MANUAL_DO_DESENVOLVEDOR_TENANTS.md"
      if [[ -f "$manual_path" ]]; then
        GIT_INDEX_FILE="$temp_idx" git add "$manual_path"
      fi

      local tree_sha
      tree_sha=$(GIT_INDEX_FILE="$temp_idx" git write-tree)
      rm -f "$temp_idx"

      local commit_msg="docs: Atualização da documentação pública oficial da Plataforma Ridel [release $tag_version]"
      local clean_commit
      clean_commit=$(git commit-tree "$tree_sha" -m "$commit_msg")

      info "Enviando documentação limpa para o repositório p-ridel..."
      # Envia para main e master para garantir compatibilidade com qualquer default branch no GitHub
      local push_ok=0
      if git push client "${clean_commit}:refs/heads/main" --force 2>/dev/null; then
        push_ok=1
      fi
      if git push client "${clean_commit}:refs/heads/master" --force 2>/dev/null; then
        push_ok=1
      fi

      if [[ "$push_ok" -eq 1 ]]; then
        success "Documentação pública publicada com sucesso em p-ridel (branches: main/master)!"
      else
        error "Falha ao enviar a documentação para o remote 'client' (p-ridel)!"
        return 1
      fi
    fi
  else
    warn "Sincronização Git ignorada via flag --skip-git."
  fi

  echo ""
  success "Processo de publicação dual finalizado com sucesso!"
  echo ""
}


docker_test() {
  local tenant=""
  local keep_image=0
  local port=8089
  local custom_port=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        echo ""
        echo -e "${BOLD}Plataforma Ridel — Validação Automatizada de Imagem All-in-One (dockertest)${NC}"
        echo -e "${DIM}Uso: ridel dockertest <tenant> [--keep-image] [--port PORT]${NC}"
        echo ""
        echo -e "Executa um ciclo completo e automatizado de testes de ponta a ponta na imagem Docker:"
        echo -e "  1. Compila o Universal Player Flutter Web em modo release;"
        echo -e "  2. Compila a engine Python com Cython (.so) e gera a imagem local;"
        echo -e "  3. Inicia um contêiner efêmero com volume persistente temporário (/tmp);"
        echo -e "  4. Executa bateria prática com 8 etapas de validação funcional;"
        echo -e "  5. Emite relatório executivo com tempos de resposta;"
        echo -e "  6. Limpa o contêiner, dados temporários e remove a imagem gerada (a menos que --keep-image)."
        echo ""
        echo -e "Opções:"
        echo -e "  ${CYAN}--keep-image${NC}        Mantém a imagem Docker compilada ao final (não remove via docker rmi)"
        echo -e "  ${CYAN}--port PORT${NC}         Porta HTTP no host para o contêiner de teste (padrão: 8089)"
        echo -e "  ${CYAN}-h, --help${NC}          Exibe esta ajuda"
        echo ""
        return 0
        ;;
      --keep-image)
        keep_image=1
        shift
        ;;
      --port)
        shift
        port="$1"
        custom_port=1
        shift
        ;;
      *)
        if [[ -z "$tenant" && ! "$1" =~ ^-- ]]; then
          tenant="$1"
        else
          error "Opção ou argumento desconhecido: $1"
          echo -e "Uso: ridel dockertest <tenant> [--keep-image] [--port PORT]"
          return 1
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$tenant" ]]; then
    error "Informe o nome do tenant para executar a validação Docker."
    echo -e "Uso: ridel dockertest <tenant> [--keep-image] [--port PORT]"
    return 1
  fi

  local tenant_path="$PROJECT_ROOT/backend/tenants/$tenant"
  if [[ ! -d "$tenant_path" ]]; then
    error "Tenant '$tenant' não encontrado em backend/tenants/!"
    return 1
  fi

  # Alocação de porta livre se a padrão estiver em uso
  if [[ "$custom_port" -eq 0 ]]; then
    while lsof -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; do
      port=$((port + 1))
      if [[ "$port" -gt 8110 ]]; then
        error "Não foi possível encontrar uma porta livre no intervalo 8089-8110."
        return 1
      fi
    done
  fi

  local tag="ridel-dockertest-${tenant}:$(date +%s)"
  local container_name="ridel_dockertest_${tenant}_$$"
  local temp_dir
  temp_dir=$(mktemp -d /tmp/ridel_dockertest_XXXXXX)
  chmod 777 "$temp_dir"

  # Variáveis globais para o trap de limpeza
  DOCKERTEST_TAG="$tag"
  DOCKERTEST_CONTAINER="$container_name"
  DOCKERTEST_DIR="$temp_dir"
  DOCKERTEST_KEEP_IMAGE="$keep_image"

  cleanup_dockertest() {
    info "Executando limpeza de recursos efêmeros..."
    if [[ -n "$DOCKERTEST_CONTAINER" ]]; then
      docker rm -f "$DOCKERTEST_CONTAINER" >/dev/null 2>&1 || true
    fi
    if [[ -n "$DOCKERTEST_DIR" && -d "$DOCKERTEST_DIR" ]]; then
      rm -rf "$DOCKERTEST_DIR" >/dev/null 2>&1 || true
    fi
    if [[ "${DOCKERTEST_KEEP_IMAGE:-0}" -eq 0 && -n "$DOCKERTEST_TAG" ]]; then
      docker rmi -f "$DOCKERTEST_TAG" >/dev/null 2>&1 || true
    fi
    success "Limpeza concluída com sucesso."
  }
  trap cleanup_dockertest EXIT INT TERM

  echo ""
  echo -e "${BOLD}══════════════════════════════════════════════════════════════${NC}"
  echo -e "${BOLD}       RIDEL DOCKERTEST — VALIDAÇÃO E2E DE IMAGEM DOCKER      ${NC}"
  echo -e "${BOLD}══════════════════════════════════════════════════════════════${NC}"
  echo -e "${DIM}Tenant Alvo:${NC}      $tenant"
  echo -e "${DIM}Imagem Efêmera:${NC}   $tag"
  echo -e "${DIM}Contêiner:${NC}        $container_name"
  echo -e "${DIM}Porta de Teste:${NC}   $port"
  echo -e "${DIM}Volume /data:${NC}     $temp_dir"
  echo -e "${DIM}Limpeza Imagem:${NC}   $([ "$keep_image" -eq 1 ] && echo "Manter (--keep-image)" || echo "Remoção Total")"
  echo -e "${BOLD}══════════════════════════════════════════════════════════════${NC}"
  echo ""

  local t_start
  t_start=$(date +%s)
  local step_start
  local step_elapsed

  # Array de resultados do relatório
  declare -a test_names=()
  declare -a test_status=()
  declare -a test_times=()

  record_test() {
    local name="$1"
    local status="$2"
    local elapsed="$3"
    test_names+=("$name")
    test_status+=("$status")
    test_times+=("${elapsed}s")
  }

  # ----------------------------------------------------------------------------
  # Etapa 1: Build da Imagem com Cython e Flutter Web
  # ----------------------------------------------------------------------------
  info "1/8: Construindo imagem All-in-One com Cython hardening ($tag)..."
  step_start=$(date +%s)
  if docker build -t "$tag" -f "$PROJECT_ROOT/Dockerfile.allinone" "$PROJECT_ROOT" >/dev/null 2>&1; then
    step_elapsed=$(( $(date +%s) - step_start ))
    success "Imagem Docker construída com sucesso (${step_elapsed}s)."
    record_test "Build All-in-One (Cython + Web)" "PASS" "$step_elapsed"
  else
    step_elapsed=$(( $(date +%s) - step_start ))
    error "Falha na compilação da imagem Docker!"
    record_test "Build All-in-One (Cython + Web)" "FAIL" "$step_elapsed"
    return 1
  fi

  # ----------------------------------------------------------------------------
  # Etapa 2: Inicialização e Healthcheck
  # ----------------------------------------------------------------------------
  info "2/8: Iniciando contêiner isolado na porta $port..."
  step_start=$(date +%s)
  local run_err
  run_err=$(docker run -d \
    --name "$container_name" \
    -p "${port}:8000" \
    -e POSTGRES_PASSWORD="dockertest_password" \
    -v "${temp_dir}:/data" \
    "$tag" 2>&1)

  if [[ $? -ne 0 ]]; then
    step_elapsed=$(( $(date +%s) - step_start ))
    error "Falha ao iniciar contêiner: $run_err"
    record_test "Inicialização do Contêiner" "FAIL" "$step_elapsed"
    return 1
  fi

  # Aguarda inicialização do Supervisord e serviços (até 30s)
  local ready=0
  local attempts=0
  while [[ $attempts -lt 30 ]]; do
    if curl -s -f "http://localhost:${port}/health" >/dev/null 2>&1; then
      local sup_stat
      sup_stat=$(docker exec "$container_name" supervisorctl status 2>/dev/null || true)
      if echo "$sup_stat" | grep -q "ridel_backend.*RUNNING" && echo "$sup_stat" | grep -q "postgresql.*RUNNING"; then
        ready=1
        break
      fi
    fi
    sleep 1
    attempts=$((attempts + 1))
  done

  step_elapsed=$(( $(date +%s) - step_start ))
  if [[ "$ready" -eq 1 ]]; then
    success "Contêiner e serviços ativos e saudáveis (${step_elapsed}s)."
    record_test "Healthcheck (Postgres + Uvicorn)" "PASS" "$step_elapsed"
  else
    error "Serviços não atingiram estado RUNNING dentro do tempo limite (${step_elapsed}s)."
    docker logs --tail 25 "$container_name" || true
    record_test "Healthcheck (Postgres + Uvicorn)" "FAIL" "$step_elapsed"
    return 1
  fi

  # ----------------------------------------------------------------------------
  # Etapa 3: SPA Routing / Anti-F5 Deep Linking
  # ----------------------------------------------------------------------------
  info "3/8: Validando SPA Fallback e recarregamento profundo (Anti-F5 404)..."
  step_start=$(date +%s)
  local deep_res
  deep_res=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:${port}/${tenant}/apps/test_view_f5")
  step_elapsed=$(( $(date +%s) - step_start ))

  if [[ "$deep_res" == "200" ]]; then
    success "SPA Fallback validado: rotas profundas retornam index.html 200 OK (${step_elapsed}s)."
    record_test "SPA Routing / Anti-F5 404" "PASS" "$step_elapsed"
  else
    error "Falha no SPA Fallback: rota profunda retornou HTTP $deep_res em vez de 200!"
    record_test "SPA Routing / Anti-F5 404" "FAIL" "$step_elapsed"
    return 1
  fi

  # ----------------------------------------------------------------------------
  # Etapa 4: Database Seed e Idempotência
  # ----------------------------------------------------------------------------
  info "4/8: Testando execução do seed do tenant '$tenant'..."
  step_start=$(date +%s)
  local seed_out
  seed_out=$(docker exec "$container_name" ridel db seed "$tenant" 2>&1)
  step_elapsed=$(( $(date +%s) - step_start ))

  if echo "$seed_out" | grep -q "concluído\|sucesso"; then
    success "Database seed executado e validado com sucesso (${step_elapsed}s)."
    record_test "Database Seed & Idempotência" "PASS" "$step_elapsed"
  else
    error "Falha na execução do seed: $seed_out"
    record_test "Database Seed & Idempotência" "FAIL" "$step_elapsed"
    return 1
  fi

  # ----------------------------------------------------------------------------
  # Etapa 5: Autenticação JWT e Sessão
  # ----------------------------------------------------------------------------
  info "5/8: Testando login de administrador e emissão de JWT..."
  step_start=$(date +%s)
  local login_json
  login_json=$(curl -s -X POST "http://localhost:${port}/api/v1/${tenant}/auth/login" \
    -H "Content-Type: application/json" \
    -d "{\"username\": \"admin@${tenant}.com\", \"password\": \"admin123\"}")

  local token
  token=$(echo "$login_json" | jq -r .access_token 2>/dev/null || true)
  step_elapsed=$(( $(date +%s) - step_start ))

  if [[ -n "$token" && "$token" != "null" ]]; then
    success "Autenticação realizada com sucesso e token JWT emitido (${step_elapsed}s)."
    record_test "Autenticação JWT / Login" "PASS" "$step_elapsed"
  else
    error "Falha no login: $login_json"
    record_test "Autenticação JWT / Login" "FAIL" "$step_elapsed"
    return 1
  fi

  # ----------------------------------------------------------------------------
  # Etapa 6: Descoberta de Apps e SDUI Manifest
  # ----------------------------------------------------------------------------
  info "6/8: Validando catálogo de Apps e entrega de Manifesto Server-Driven UI..."
  step_start=$(date +%s)
  local apps_list
  apps_list=$(curl -s "http://localhost:${port}/api/v1/${tenant}/apps" -H "Authorization: Bearer $token")
  local first_app_id
  first_app_id=$(echo "$apps_list" | jq -r '.[0].app_id' 2>/dev/null || true)

  local manifest_ok=0
  if [[ -n "$first_app_id" && "$first_app_id" != "null" ]]; then
    local manifest
    manifest=$(curl -s "http://localhost:${port}/api/v1/${tenant}/apps/${first_app_id}" -H "Authorization: Bearer $token")
    if echo "$manifest" | jq -e '.views and .tables' >/dev/null 2>&1; then
      manifest_ok=1
    fi
  fi
  step_elapsed=$(( $(date +%s) - step_start ))

  if [[ "$manifest_ok" -eq 1 ]]; then
    success "Catálogo e manifesto SDUI do app '$first_app_id' validados (${step_elapsed}s)."
    record_test "Descoberta de Apps & SDUI" "PASS" "$step_elapsed"
  else
    error "Falha ao validar catálogo e manifesto SDUI: $apps_list"
    record_test "Descoberta de Apps & SDUI" "FAIL" "$step_elapsed"
    return 1
  fi

  # ----------------------------------------------------------------------------
  # Etapa 7: CRUD de Dados e Busca ILIKE
  # ----------------------------------------------------------------------------
  info "7/8: Testando operações CRUD com inserção e busca global (ILIKE)..."
  step_start=$(date +%s)
  local random_suffix
  random_suffix=$(date +%s)
  local test_name="Dockertest Corp $random_suffix"
  local crud_insert
  crud_insert=$(curl -s -X POST "http://localhost:${port}/api/v1/${tenant}/tables/customers/records" \
    -H "Authorization: Bearer $token" \
    -H "Content-Type: application/json" \
    -d "{\"name\": \"$test_name\", \"client_type\": \"PJ\", \"cnpj\": \"11.222.333/0001-44\"}")

  local inserted_id
  inserted_id=$(echo "$crud_insert" | jq -r .id 2>/dev/null || true)

  local search_found=0
  if [[ -n "$inserted_id" && "$inserted_id" != "null" ]]; then
    local search_res
    search_res=$(curl -s "http://localhost:${port}/api/v1/${tenant}/tables/customers/records?search=${random_suffix}" \
      -H "Authorization: Bearer $token")
    if echo "$search_res" | jq -e ".items[] | select(.id == \"$inserted_id\")" >/dev/null 2>&1; then
      search_found=1
    fi
  fi
  step_elapsed=$(( $(date +%s) - step_start ))

  if [[ "$search_found" -eq 1 ]]; then
    success "Registro criado e localizado via busca global ILIKE com sucesso (${step_elapsed}s)."
    record_test "CRUD & Busca Global (ILIKE)" "PASS" "$step_elapsed"
  else
    error "Falha no teste de CRUD ou busca global: $crud_insert"
    record_test "CRUD & Busca Global (ILIKE)" "FAIL" "$step_elapsed"
    return 1
  fi

  # ----------------------------------------------------------------------------
  # Etapa 8: Hot-Reload Declarativo a Quente (WatchFiles + Auto-Reconciliação)
  # ----------------------------------------------------------------------------
  info "8/8: Testando Hot-Reload Declarativo com injeção a quente de novo campo..."
  step_start=$(date +%s)
  local hot_reload_ok=0

  # Injetar campo declarativo temporário em CustomerTable dentro do container
  if docker exec "$container_name" sed -i '/class CustomerTable(Table):/a \    dockertest_field = TextField(label="Campo Teste HotReload", required=False)' "/data/tenants/$tenant/tables.py"; then
    # Aguardar 2.5 segundos para o WatchFiles detectar e recarregar
    sleep 2.5

    local new_manifest
    new_manifest=$(curl -s "http://localhost:${port}/api/v1/${tenant}/apps/${first_app_id}" -H "Authorization: Bearer $token")
    if echo "$new_manifest" | grep -q "dockertest_field"; then
      hot_reload_ok=1
    fi
  fi
  step_elapsed=$(( $(date +%s) - step_start ))

  if [[ "$hot_reload_ok" -eq 1 ]]; then
    success "Hot-Reload a quente validado: novo campo detectado e exposto no manifesto (${step_elapsed}s)."
    record_test "Hot-Reload Declarativo (WatchFiles)" "PASS" "$step_elapsed"
  else
    error "Falha ao validar recarregamento a quente do campo declarativo!"
    record_test "Hot-Reload Declarativo (WatchFiles)" "FAIL" "$step_elapsed"
    return 1
  fi

  # ----------------------------------------------------------------------------
  # Relatório Executivo Final
  # ----------------------------------------------------------------------------
  local total_elapsed=$(( $(date +%s) - t_start ))
  echo ""
  echo -e "${BOLD}══════════════════════════════════════════════════════════════════════════════${NC}"
  echo -e "${BOLD}                    RELATÓRIO DE VALIDAÇÃO DOCKERTEST                         ${NC}"
  echo -e "${BOLD}══════════════════════════════════════════════════════════════════════════════${NC}"
  printf "${BOLD}%-40s %-12s %-10s${NC}\n" "BATERIA DE TESTES" "RESULTADO" "DURAÇÃO"
  echo "──────────────────────────────────────────────────────────────────────────────"
  for i in "${!test_names[@]}"; do
    local st="${test_status[$i]}"
    local st_fmt=""
    if [[ "$st" == "PASS" ]]; then
      st_fmt="${GREEN}✔ PASSOU${NC}  "
    else
      st_fmt="${RED}✖ FALHOU${NC}  "
    fi
    printf "%-40s %-20b %-10s\n" "${test_names[$i]}" "$st_fmt" "${test_times[$i]}"
  done
  echo "──────────────────────────────────────────────────────────────────────────────"
  echo -e "${BOLD}Status Consolidado:${NC} ${GREEN}100% APROVADO (8 de 8 testes passaram)${NC}"
  echo -e "${BOLD}Tempo Total:${NC}        ${total_elapsed}s"
  echo -e "${BOLD}══════════════════════════════════════════════════════════════════════════════${NC}"
  echo ""

  cleanup_dockertest
  trap - EXIT INT TERM
  return 0
}

# ------------------------------------------------------------------------------
# 8. Atualização e Rollback de Imagem Docker All-in-One (ridel update / rollback)
# ------------------------------------------------------------------------------

docker_update() {
  local version=""
  local container_name="ridel"
  local custom_port=""
  local skip_healthcheck=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        echo ""
        echo -e "${BOLD}Plataforma Ridel — Atualização de Imagem Docker (ridel update)${NC}"
        echo -e "${DIM}Uso: ridel update [versao] [opções]${NC}"
        echo ""
        echo -e "Atualiza o contêiner oficial da Plataforma Ridel (ghcr.io/p-ridel/p-ridel) preservando dados locais:"
        echo -e "  1. Inspeciona o contêiner ativo e salva snapshot local para rollback;"
        echo -e "  2. Baixa a nova imagem do GitHub Container Registry (GHCR);"
        echo -e "  3. Recria o contêiner preservando 100% dos volumes montados (/data), portas e variáveis;"
        echo -e "  4. Executa healthcheck confirmando a integridade da nova versão."
        echo ""
        echo -e "Opções:"
        echo -e "  ${CYAN}--name <nome>${NC}          Nome do contêiner Docker a atualizar (padrão: ridel)"
        echo -e "  ${CYAN}--port <porta>${NC}         Porta HTTP no host para testar o healthcheck"
        echo -e "  ${CYAN}--skip-healthcheck${NC}    Pula a verificação de saúde pós-atualização"
        echo -e "  ${CYAN}-h, --help${NC}             Exibe este menu de ajuda"
        echo ""
        return 0
        ;;
      --name)
        shift
        container_name="$1"
        shift
        ;;
      --port)
        shift
        custom_port="$1"
        shift
        ;;
      --skip-healthcheck)
        skip_healthcheck=1
        shift
        ;;
      *)
        if [[ -z "$version" && ! "$1" =~ ^-- ]]; then
          version="$1"
        else
          warn "Opção desconhecida para update: $1"
        fi
        shift
        ;;
    esac
  done

  if is_container_env; then
    warn "O comando 'ridel update' gerencia o ciclo de vida do contêiner Docker e deve ser executado no host."
    info "Execute no terminal da sua máquina: ridel update"
    return 1
  fi

  if ! command -v docker >/dev/null 2>&1; then
    error "Docker não encontrado no sistema host."
    return 1
  fi

  if ! docker inspect "$container_name" >/dev/null 2>&1; then
    error "Contêiner '$container_name' não encontrado ou inexistente."
    info "Verifique se o contêiner está rodando com 'docker ps' ou especifique outro nome via '--name'."
    return 1
  fi

  info "Inspecionando contêiner '$container_name'..."
  local current_image_id
  current_image_id=$(docker inspect "$container_name" --format '{{.Image}}' 2>/dev/null || true)

  if [[ -z "$current_image_id" || "$current_image_id" == "null" ]]; then
    error "Não foi possível identificar a imagem atual do contêiner '$container_name'."
    return 1
  fi

  local rollback_tag="ghcr.io/p-ridel/p-ridel:rollback_backup"
  info "Criando snapshot local de rollback ($rollback_tag)..."
  docker tag "$current_image_id" "$rollback_tag" >/dev/null 2>&1 || true

  local ridel_runtime_dir=".ridel"
  mkdir -p "$ridel_runtime_dir"
  echo "$current_image_id" > "$ridel_runtime_dir/rollback_image_id"

  local target_tag="latest"
  if [[ -n "$version" ]]; then
    target_tag="$version"
  fi
  local target_image="ghcr.io/p-ridel/p-ridel:${target_tag}"

  info "Baixando nova imagem: $target_image..."
  if ! docker pull "$target_image"; then
    error "Falha ao baixar imagem $target_image do GHCR. O contêiner atual não foi modificado."
    return 1
  fi

  # Extrair portas
  local port_args=()
  local host_http_port="8000"
  local raw_ports
  raw_ports=$(docker inspect "$container_name" --format '{{range $port, $bindings := .HostConfig.PortBindings}}{{range $bindings}}{{.HostPort}}:{{$port}}
{{end}}{{end}}' 2>/dev/null || true)
  if [[ -n "$raw_ports" ]]; then
    while IFS= read -r p_bind; do
      if [[ -n "$p_bind" ]]; then
        port_args+=("-p" "$p_bind")
        if [[ "$p_bind" == *":8000"* ]]; then
          host_http_port="${p_bind%%:*}"
        fi
      fi
    done <<< "$raw_ports"
  fi

  if [[ -n "$custom_port" ]]; then
    host_http_port="$custom_port"
  fi

  if [[ ${#port_args[@]} -eq 0 ]]; then
    port_args=("-p" "${host_http_port}:8000" "-p" "5432:5432")
  fi

  # Extrair mounts / volumes
  local mount_args=()
  local raw_mounts
  raw_mounts=$(docker inspect "$container_name" --format '{{range .Mounts}}{{.Source}}:{{.Destination}}
{{end}}' 2>/dev/null || true)
  if [[ -n "$raw_mounts" ]]; then
    while IFS= read -r mnt; do
      if [[ -n "$mnt" ]]; then
        mount_args+=("-v" "$mnt")
      fi
    done <<< "$raw_mounts"
  fi

  # Extrair variáveis de ambiente
  local env_args=()
  local raw_envs
  raw_envs=$(docker inspect "$container_name" --format '{{range .Config.Env}}{{.}}
{{end}}' 2>/dev/null || true)
  if [[ -n "$raw_envs" ]]; then
    while IFS= read -r env_item; do
      if [[ "$env_item" =~ ^(POSTGRES_|SECRET_KEY|TENANTS_DIR|RIDEL_) ]]; then
        env_args+=("-e" "$env_item")
      fi
    done <<< "$raw_envs"
  fi

  info "Parando contêiner atual '$container_name'..."
  docker stop "$container_name" >/dev/null 2>&1 || true
  docker rm "$container_name" >/dev/null 2>&1 || true

  local run_cmd=(docker run -d --name "$container_name" --restart unless-stopped)
  run_cmd+=("${port_args[@]}")
  run_cmd+=("${mount_args[@]}")
  run_cmd+=("${env_args[@]}")
  run_cmd+=("$target_image")

  info "Iniciando contêiner atualizado..."
  if ! "${run_cmd[@]}"; then
    error "Falha ao iniciar contêiner com nova imagem!"
    warn "Restaurando versão anterior automaticamente..."
    docker_rollback --name "$container_name"
    return 1
  fi

  if [[ $skip_healthcheck -eq 0 ]]; then
    info "Aguardando healthcheck em http://localhost:${host_http_port}/health (até 30s)..."
    local healthy=0
    local attempts=0
    while [[ $attempts -lt 30 ]]; do
      if curl -s -f "http://localhost:${host_http_port}/health" >/dev/null 2>&1; then
        healthy=1
        break
      fi
      sleep 1
      attempts=$((attempts + 1))
    done

    if [[ $healthy -eq 1 ]]; then
      success "Contêiner '$container_name' atualizado para '$target_image' com sucesso!"
      echo ""
      echo -e "${DIM}💡 Dica: Se precisar reverter para a versão anterior, execute:${NC}"
      echo -e "${CYAN}   ridel rollback --name $container_name${NC}"
      echo ""
    else
      warn "O contêiner subiu, mas não respondeu ao healthcheck na porta ${host_http_port} dentro de 30s."
      warn "Se houver falha, você pode reverter imediatamente com: ridel rollback --name $container_name"
    fi
  else
    success "Contêiner '$container_name' atualizado com sucesso (healthcheck ignorado via flag)."
  fi
  if ! is_container_env; then
    echo ""
    cli_self_update || true
  fi
  return 0
}

docker_rollback() {
  local container_name="ridel"
  local custom_port=""
  local skip_healthcheck=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        echo ""
        echo -e "${BOLD}Plataforma Ridel — Reversão de Imagem Docker (ridel rollback)${NC}"
        echo -e "${DIM}Uso: ridel rollback [opções]${NC}"
        echo ""
        echo -e "Reverte o contêiner para o snapshot local da versão anterior sem necessidade de download:"
        echo -e "  1. Localiza a imagem de backup (ghcr.io/p-ridel/p-ridel:rollback_backup);"
        echo -e "  2. Reinicia o contêiner preservando 100% dos volumes montados (/data), portas e variáveis;"
        echo -e "  3. Valida a restauração via healthcheck."
        echo ""
        echo -e "Opções:"
        echo -e "  ${CYAN}--name <nome>${NC}          Nome do contêiner Docker a reverter (padrão: ridel)"
        echo -e "  ${CYAN}--port <porta>${NC}         Porta HTTP no host para testar o healthcheck"
        echo -e "  ${CYAN}--skip-healthcheck${NC}    Pula a verificação de saúde pós-reversão"
        echo -e "  ${CYAN}-h, --help${NC}             Exibe este menu de ajuda"
        echo ""
        return 0
        ;;
      --name)
        shift
        container_name="$1"
        shift
        ;;
      --port)
        shift
        custom_port="$1"
        shift
        ;;
      --skip-healthcheck)
        skip_healthcheck=1
        shift
        ;;
      *)
        warn "Opção desconhecida para rollback: $1"
        shift
        ;;
    esac
  done

  if is_container_env; then
    warn "O comando 'ridel rollback' gerencia o ciclo de vida do contêiner Docker e deve ser executado no host."
    info "Execute no terminal da sua máquina: ridel rollback"
    return 1
  fi

  if ! command -v docker >/dev/null 2>&1; then
    error "Docker não encontrado no sistema host."
    return 1
  fi

  local rollback_image="ghcr.io/p-ridel/p-ridel:rollback_backup"
  local rollback_id=""
  if [[ -f ".ridel/rollback_image_id" ]]; then
    rollback_id=$(cat ".ridel/rollback_image_id" 2>/dev/null || true)
  fi

  local has_backup=0
  if docker inspect "$rollback_image" >/dev/null 2>&1; then
    has_backup=1
  elif [[ -n "$rollback_id" ]] && docker inspect "$rollback_id" >/dev/null 2>&1; then
    has_backup=1
    rollback_image="$rollback_id"
  fi

  if [[ $has_backup -eq 0 ]]; then
    error "Nenhum snapshot de backup encontrado para rollback!"
    info "A imagem '$rollback_image' ou registro em '.ridel/rollback_image_id' não foi localizado."
    return 1
  fi

  if ! docker inspect "$container_name" >/dev/null 2>&1; then
    error "Contêiner '$container_name' não encontrado ou inexistente."
    return 1
  fi

  info "Inspecionando contêiner '$container_name' para rollback..."

  # Portas
  local port_args=()
  local host_http_port="8000"
  local raw_ports
  raw_ports=$(docker inspect "$container_name" --format '{{range $port, $bindings := .HostConfig.PortBindings}}{{range $bindings}}{{.HostPort}}:{{$port}}
{{end}}{{end}}' 2>/dev/null || true)
  if [[ -n "$raw_ports" ]]; then
    while IFS= read -r p_bind; do
      if [[ -n "$p_bind" ]]; then
        port_args+=("-p" "$p_bind")
        if [[ "$p_bind" == *":8000"* ]]; then
          host_http_port="${p_bind%%:*}"
        fi
      fi
    done <<< "$raw_ports"
  fi

  if [[ -n "$custom_port" ]]; then
    host_http_port="$custom_port"
  fi

  if [[ ${#port_args[@]} -eq 0 ]]; then
    port_args=("-p" "${host_http_port}:8000" "-p" "5432:5432")
  fi

  # Mounts / Volumes
  local mount_args=()
  local raw_mounts
  raw_mounts=$(docker inspect "$container_name" --format '{{range .Mounts}}{{.Source}}:{{.Destination}}
{{end}}' 2>/dev/null || true)
  if [[ -n "$raw_mounts" ]]; then
    while IFS= read -r mnt; do
      if [[ -n "$mnt" ]]; then
        mount_args+=("-v" "$mnt")
      fi
    done <<< "$raw_mounts"
  fi

  # Variáveis de ambiente
  local env_args=()
  local raw_envs
  raw_envs=$(docker inspect "$container_name" --format '{{range .Config.Env}}{{.}}
{{end}}' 2>/dev/null || true)
  if [[ -n "$raw_envs" ]]; then
    while IFS= read -r env_item; do
      if [[ "$env_item" =~ ^(POSTGRES_|SECRET_KEY|TENANTS_DIR|RIDEL_) ]]; then
        env_args+=("-e" "$env_item")
      fi
    done <<< "$raw_envs"
  fi

  info "Parando contêiner atual '$container_name'..."
  docker stop "$container_name" >/dev/null 2>&1 || true
  docker rm "$container_name" >/dev/null 2>&1 || true

  local run_cmd=(docker run -d --name "$container_name" --restart unless-stopped)
  run_cmd+=("${port_args[@]}")
  run_cmd+=("${mount_args[@]}")
  run_cmd+=("${env_args[@]}")
  run_cmd+=("$rollback_image")

  info "Recriando contêiner com imagem de rollback ($rollback_image)..."
  if ! "${run_cmd[@]}"; then
    error "Falha ao recriar contêiner a partir da imagem de rollback!"
    return 1
  fi

  if [[ $skip_healthcheck -eq 0 ]]; then
    info "Validando saúde em http://localhost:${host_http_port}/health (até 30s)..."
    local healthy=0
    local attempts=0
    while [[ $attempts -lt 30 ]]; do
      if curl -s -f "http://localhost:${host_http_port}/health" >/dev/null 2>&1; then
        healthy=1
        break
      fi
      sleep 1
      attempts=$((attempts + 1))
    done

    if [[ $healthy -eq 1 ]]; then
      success "Rollback concluído! Contêiner '$container_name' restaurado com sucesso para a versão anterior."
    else
      warn "O contêiner foi recriado, mas não respondeu ao healthcheck na porta ${host_http_port} dentro de 30s."
    fi
  else
    success "Rollback concluído (healthcheck ignorado via flag)."
  fi
  return 0
}


#!/usr/bin/env bash
# ==============================================================================
# Plataforma Ridel — CLI de Desenvolvimento e Gestão de Serviços
# ==============================================================================

# Resolver diretório raiz do projeto mesmo se executado via symlink
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
PROJECT_ROOT="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

# Diretórios de runtime (PIDs e Logs)
RUN_DIR="$PROJECT_ROOT/.ridel"
PID_DIR="${PID_DIR:-$RUN_DIR/pids}"
LOG_DIR="${LOG_DIR:-$RUN_DIR/logs}"

mkdir -p "$PID_DIR" "$LOG_DIR"

# Estilos e Cores ANSI
BOLD='\033[1m'
DIM='\033[2m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m' # No Color

# Helper de logs no terminal
info()    { echo -e "${CYAN}ℹ${NC} $1"; }
success() { echo -e "${GREEN}✔${NC} $1"; }
warn()    { echo -e "${YELLOW}▲${NC} $1"; }
error()   { echo -e "${RED}✖${NC} $1"; }

# ------------------------------------------------------------------------------
# Funções Utilitárias de Processo e Rede
# ------------------------------------------------------------------------------

is_pid_alive() {
  local pid="$1"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

find_pid_by_port() {
  local port="$1"
  lsof -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null | head -n 1
}

kill_process() {
  local name="$1"
  local pid="$2"

  if is_pid_alive "$pid"; then
    echo -n "Encerrando $name (PID: $pid)... "
    kill -TERM "$pid" 2>/dev/null || true
    
    # Aguarda até 5 segundos para finalização graciosa
    local count=0
    while is_pid_alive "$pid" && [ $count -lt 10 ]; do
      sleep 0.5
      count=$((count + 1))
    done

    # Força finalização se ainda estiver ativo
    if is_pid_alive "$pid"; then
      kill -KILL "$pid" 2>/dev/null || true
      echo -e "${YELLOW}(forçado)${NC}"
    else
      echo -e "${GREEN}(sucesso)${NC}"
    fi
  fi
}

is_container_env() {
  [ -f /.dockerenv ] || [ -f /run/.containerenv ]
}

is_standalone_host() {
  if is_container_env; then
    return 1
  fi
  [ ! -d "$PROJECT_ROOT/backend" ]
}

standalone_container_running() {
  local container_name="${1:-ridel}"
  docker ps --format '{{.Names}}' 2>/dev/null | grep -wq "^${container_name}$"
}

standalone_proxy() {
  local container_name="ridel"
  if ! standalone_container_running "$container_name"; then
    error "O contêiner '$container_name' não está em execução."
    info "Inicie a plataforma no host com: ridel start"
    return 1
  fi

  if [ -t 0 ] && [ -t 1 ]; then
    docker exec -it "$container_name" ridel "$@"
  else
    docker exec "$container_name" ridel "$@"
  fi
}

standalone_start() {
  local container_name="ridel"
  if standalone_container_running "$container_name"; then
    info "O contêiner '$container_name' já está em execução."
    return 0
  fi

  if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -wq "^${container_name}$"; then
    info "Iniciando contêiner '$container_name' existente..."
    docker start "$container_name"
    success "Contêiner '$container_name' iniciado com sucesso."
  else
    info "Iniciando contêiner oficial '$container_name' da Plataforma Ridel..."
    mkdir -p "$HOME/ridel-data"
    docker run -d \
      --name "$container_name" \
      --restart unless-stopped \
      -p 8000:8000 \
      -p 5432:5432 \
      -v "$HOME/ridel-data:/data" \
      ghcr.io/p-ridel/p-ridel:latest
    success "Contêiner '$container_name' criado e iniciado."
  fi
}

standalone_stop() {
  local container_name="ridel"
  info "Parando contêiner '$container_name'..."
  docker stop "$container_name"
  success "Contêiner '$container_name' parado com sucesso."
}

standalone_restart() {
  local container_name="ridel"
  info "Reiniciando contêiner '$container_name'..."
  docker restart "$container_name"
  success "Contêiner '$container_name' reiniciado com sucesso."
}

standalone_logs() {
  local container_name="ridel"
  docker logs -f "$container_name"
}

standalone_status() {
  local container_name="ridel"
  info "Status da Plataforma Ridel (Modo Host):"
  if standalone_container_running "$container_name"; then
    success "Contêiner '$container_name': EM EXECUÇÃO"
    docker ps --filter "name=^${container_name}$" --format "ID: {{.ID}} | Imagem: {{.Image}} | Status: {{.Status}} | Portas: {{.Ports}}"
    local http_code
    http_code=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:8000/health" 2>/dev/null || echo "000")
    if [ "$http_code" = "200" ]; then
      success "Engine FastAPI / Universal Player: OK (http://localhost:8000)"
    else
      warn "Engine FastAPI: aguardando inicialização (HTTP $http_code)"
    fi
  else
    warn "Contêiner '$container_name': PARADO"
    info "Execute 'ridel start' para subir o contêiner."
  fi
}

cli_self_update() {
  info "Verificando atualizações da CLI 'ridel' no GitHub..."
  local target_path
  target_path="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"

  local raw_url="${RIDEL_RAW_URL:-https://raw.githubusercontent.com/p-ridel/p-ridel/main/ridel}"
  local tmp_file
  tmp_file="$(mktemp)"

  if curl -fsSL "$raw_url" -o "$tmp_file"; then
    chmod +x "$tmp_file"
    mv "$tmp_file" "$target_path"
    success "CLI 'ridel' atualizada com sucesso!"
  else
    rm -f "$tmp_file"
    error "Falha ao baixar atualização da CLI de $raw_url."
    return 1
  fi
}

tenant_create() {
  local name="$1"
  shift || true
  local title=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title)
        title="$2"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  if [[ -z "$name" ]]; then
    error "Informe o nome do tenant. Uso: ridel tenant create <nome> [--title 'Título']"
    return 1
  fi

  if [[ -z "$title" ]]; then
    title="$name"
  fi

  local base_dir=""
  if is_container_env; then
    base_dir="/data/tenants/$name"
  else
    base_dir="$PROJECT_ROOT/backend/tenants/$name"
  fi

  if [[ -d "$base_dir" ]]; then
    warn "O tenant '$name' já existe em $base_dir."
    return 0
  fi

  info "Criando estrutura do tenant '$name' em $base_dir..."
  mkdir -p "$base_dir/apps"

  cat << 'EOF' > "$base_dir/app.py"
"""Tenant application metadata and facade."""
from .tables import *
from .views import views

__all__ = ["views"]
EOF

  cat << 'EOF' > "$base_dir/tables.py"
"""Declarative data models and tables."""
from engine.fields import IntegerField, StringField, DateTimeField
from engine.table import Table

class ItemTable(Table):
    id = IntegerField(primary_key=True)
    name = StringField(label="Nome", required=True)
    created_at = DateTimeField(label="Criado em", auto_now_add=True)
EOF

  cat << 'EOF' > "$base_dir/views.py"
"""Declarative views and UI layout."""
from engine.views import TableView, FormView

views = [
    TableView(name="items_list", table="ItemTable", label="Itens", position="primary"),
    FormView(name="item_form", table="ItemTable", label="Formulário do Item", position="ref"),
]
EOF

  cat << 'EOF' > "$base_dir/roles.py"
"""Role-based access control (RBAC)."""
roles = {
    "admin": {"ItemTable": ["read", "write", "delete"]},
    "user": {"ItemTable": ["read"]},
}
EOF

  cat << 'EOF' > "$base_dir/actions.py"
"""Custom business actions."""
EOF

  cat << 'EOF' > "$base_dir/user.py"
"""Declarative users."""
users = [
    {"username": f"admin@{name}.com", "password": "admin123", "role": "admin"}
]
EOF

  success "Tenant '$name' ($title) criado com sucesso em: $base_dir"
  info "Você já pode editar as tabelas em $base_dir/tables.py e views em $base_dir/views.py."
}

# ------------------------------------------------------------------------------
# 1. Banco de Dados (PostgreSQL via Docker / Supervisord)
# ------------------------------------------------------------------------------

db_start() {
  if is_container_env; then
    if command -v supervisorctl >/dev/null 2>&1; then
      info "Ambiente Docker detectado: iniciando PostgreSQL via Supervisord..."
      supervisorctl start postgresql
      return $?
    fi
  fi
  info "Iniciando container do PostgreSQL..."
  docker compose -f "$PROJECT_ROOT/docker-compose.yml" up -d
  if [ $? -eq 0 ]; then
    success "PostgreSQL iniciado com sucesso via Docker Compose."
  else
    error "Falha ao iniciar o PostgreSQL."
    return 1
  fi
}

db_stop() {
  if is_container_env; then
    if command -v supervisorctl >/dev/null 2>&1; then
      info "Ambiente Docker detectado: parando PostgreSQL via Supervisord..."
      supervisorctl stop postgresql
      return $?
    fi
  fi
  info "Parando container do PostgreSQL..."
  docker compose -f "$PROJECT_ROOT/docker-compose.yml" down
  success "PostgreSQL finalizado."
}

db_restart() {
  if is_container_env; then
    if command -v supervisorctl >/dev/null 2>&1; then
      info "Ambiente Docker detectado: reiniciando PostgreSQL via Supervisord..."
      supervisorctl restart postgresql
      return $?
    fi
  fi
  info "Reiniciando PostgreSQL..."
  docker compose -f "$PROJECT_ROOT/docker-compose.yml" restart
  success "PostgreSQL reiniciado."
}

db_status() {
  if is_container_env; then
    if command -v supervisorctl >/dev/null 2>&1; then
      local pg_stat
      pg_stat=$(supervisorctl status postgresql 2>/dev/null)
      if [[ "$pg_stat" == *"RUNNING"* ]]; then
        success "PostgreSQL (Supervisord): $pg_stat"
        return 0
      else
        warn "PostgreSQL (Supervisord): $pg_stat"
        return 1
      fi
    fi
  fi
  local status_output
  status_output=$(docker compose -f "$PROJECT_ROOT/docker-compose.yml" ps --format "{{.Name}}: {{.State}} ({{.Health}})" 2>/dev/null)
  if [ -n "$status_output" ]; then
    success "PostgreSQL: $status_output"
    return 0
  else
    warn "PostgreSQL: Parado / Não encontrado."
    return 1
  fi
}

db_logs() {
  local tenant=""
  local days=""
  local tail_lines="100"
  local all_logs=false

  while [ $# -gt 0 ]; do
    case "$1" in
      -t|--tenant)
        tenant="$2"
        shift 2
        ;;
      -d|--days)
        days="$2"
        shift 2
        ;;
      --today)
        days="0"
        shift
        ;;
      --tail|-n)
        tail_lines="$2"
        shift 2
        ;;
      --all)
        all_logs=true
        shift
        ;;
      -*)
        warn "Opção desconhecida: $1"
        shift
        ;;
      *)
        if [ -z "$tenant" ]; then
          tenant="$1"
        fi
        shift
        ;;
    esac
  done

  local compose_args=("-f" "$PROJECT_ROOT/docker-compose.yml" "logs")

  # Tratamento do filtro temporal (--since)
  if [ -n "$days" ]; then
    if [ "$days" -eq 0 ] 2>/dev/null; then
      local today_start
      today_start=$(date +%Y-%m-%dT00:00:00)
      compose_args+=("--since" "$today_start")
    elif [ "$days" -gt 0 ] 2>/dev/null; then
      local hours=$((days * 24))
      compose_args+=("--since" "${hours}h")
    else
      warn "Valor inválido para dias: '$days'. Ignorando filtro temporal."
    fi
  fi

  # Tratamento do limite de linhas (padrão: 100 linhas a menos que --all seja informado)
  if [ "$all_logs" = false ]; then
    compose_args+=("--tail" "$tail_lines")
  fi

  compose_args+=("-f" "postgres")

  if [ -n "$tenant" ]; then
    info "Acompanhando logs em tempo real para o tenant '$tenant' (Ctrl+C para sair)..."
    docker compose "${compose_args[@]}" | grep --line-buffered -iE "tenant[:_]$tenant|tenant_$tenant|\[$tenant\]|\b$tenant\b"
  else
    docker compose "${compose_args[@]}"
  fi
}

db_seed() {
  local tenant="demo"
  local extra_args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -t|--tenant)
        tenant="$2"
        extra_args+=("-t" "$2")
        shift 2
        ;;
      *)
        extra_args+=("$1")
        shift
        ;;
    esac
  done

  info "Executando seed para o tenant '$tenant' no banco de dados..."
  local py_bin="$PROJECT_ROOT/backend/.venv/bin/python"
  if is_container_env && [ -f "/opt/venv/bin/python" ]; then
    py_bin="/opt/venv/bin/python"
    if [ -f "/data/.env" ]; then
      set -a
      source /data/.env 2>/dev/null || true
      set +a
    elif [ -f "/etc/environment" ]; then
      set -a
      source /etc/environment 2>/dev/null || true
      set +a
    fi
  elif [ ! -f "$py_bin" ]; then
    error "Ambiente virtual Python não encontrado em backend/.venv. Execute a configuração antes."
    return 1
  fi
  (cd "$PROJECT_ROOT/backend" && "$py_bin" scripts/seed.py "${extra_args[@]}")
  success "Seed executado com sucesso."
}

# ------------------------------------------------------------------------------
# 2. Backend (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------

backend_start() {
  if is_container_env; then
    if command -v supervisorctl >/dev/null 2>&1; then
      info "Ambiente Docker detectado: iniciando Backend via Supervisord..."
      supervisorctl start ridel_backend
      return $?
    fi
  fi
  local foreground=false
  for arg in "$@"; do
    if [[ "$arg" == "-f" || "$arg" == "--foreground" ]]; then
      foreground=true
    fi
  done

  # Verificar se a porta 8000 já está em uso
  local existing_pid
  existing_pid=$(find_pid_by_port 8000)
  if [ -n "$existing_pid" ]; then
    warn "Backend já parece estar em execução na porta 8000 (PID: $existing_pid)."
    return 0
  fi

  local uvicorn_bin="$PROJECT_ROOT/backend/.venv/bin/uvicorn"
  if [ ! -f "$uvicorn_bin" ]; then
    error "Uvicorn não encontrado em backend/.venv/bin/uvicorn. Crie o venv e instale as dependências."
    return 1
  fi

  if [ "$foreground" = true ]; then
    info "Iniciando Backend em primeiro plano na porta 8000 (Ctrl+C para encerrar)..."
    cd "$PROJECT_ROOT/backend" && "$uvicorn_bin" ridel.api.main:app --reload --port 8000
  else
    info "Iniciando Backend em segundo plano na porta 8000..."
    cd "$PROJECT_ROOT/backend"
    setsid "$uvicorn_bin" ridel.api.main:app --reload --port 8000 < /dev/null > "$LOG_DIR/backend.log" 2>&1 &
    local new_pid=$!
    echo "$new_pid" > "$PID_DIR/backend.pid"

    sleep 1.5
    if is_pid_alive "$new_pid"; then
      success "Backend rodando em background (PID: $new_pid) → http://localhost:8000"
      info "Logs disponíveis em: .ridel/logs/backend.log (ou execute: ridel backend logs)"
    else
      error "Falha ao iniciar o Backend. Verifique o log com: ridel backend logs"
      return 1
    fi
  fi
}

backend_stop() {
  if is_container_env; then
    if command -v supervisorctl >/dev/null 2>&1; then
      info "Ambiente Docker detectado: parando Backend via Supervisord..."
      supervisorctl stop ridel_backend
      return $?
    fi
  fi
  local pid=""
  if [ -f "$PID_DIR/backend.pid" ]; then
    pid=$(cat "$PID_DIR/backend.pid")
  fi

  local port_pid
  port_pid=$(find_pid_by_port 8000)

  if [ -n "$pid" ]; then
    kill_process "Backend (FastAPI)" "$pid"
    rm -f "$PID_DIR/backend.pid"
  fi

  if [ -n "$port_pid" ] && [ "$port_pid" != "$pid" ]; then
    kill_process "Processo residual na porta 8000" "$port_pid"
  fi

  if [ -z "$pid" ] && [ -z "$port_pid" ]; then
    info "Backend não está em execução."
  fi
}

backend_restart() {
  if is_container_env; then
    if command -v supervisorctl >/dev/null 2>&1; then
      info "Ambiente Docker detectado: reiniciando Backend via Supervisord..."
      supervisorctl restart ridel_backend
      return $?
    fi
  fi
  info "Reiniciando Backend..."
  backend_stop
  sleep 1
  backend_start "$@"
}

backend_status() {
  if is_container_env; then
    if command -v supervisorctl >/dev/null 2>&1; then
      local be_stat
      be_stat=$(supervisorctl status ridel_backend 2>/dev/null)
      if [[ "$be_stat" == *"RUNNING"* ]]; then
        success "Backend (Supervisord): $be_stat → http://localhost:8000"
        return 0
      else
        warn "Backend (Supervisord): $be_stat"
        return 1
      fi
    fi
  fi
  local port_pid
  port_pid=$(find_pid_by_port 8000)

  local pid=""
  if [ -f "$PID_DIR/backend.pid" ]; then
    pid=$(cat "$PID_DIR/backend.pid")
  fi

  if [ -n "$port_pid" ]; then
    local http_code
    http_code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 2 http://localhost:8000/docs 2>/dev/null || echo "000")
    if [ "$http_code" == "200" ]; then
      success "Backend: RODANDO (PID: $port_pid na porta 8000 - HTTP $http_code OK) → http://localhost:8000"
    else
      warn "Backend: INICIANDO / OCUPADO (PID: $port_pid na porta 8000 - HTTP $http_code)"
    fi
    return 0
  elif is_pid_alive "$pid"; then
    warn "Backend: INICIANDO (PID: $pid) → http://localhost:8000 (Acompanhe com: ridel backend logs)"
    return 0
  else
    warn "Backend: PARADO"
    return 1
  fi
}

backend_logs() {
  if [ ! -f "$LOG_DIR/backend.log" ]; then
    warn "Arquivo de log não encontrado em $LOG_DIR/backend.log"
    return 1
  fi
  tail -f "$LOG_DIR/backend.log"
}

# ------------------------------------------------------------------------------
# 3. Frontend (Flutter Web)
# ------------------------------------------------------------------------------

find_flutter_bin() {
  if [ -x "$HOME/snap/flutter/common/flutter/bin/flutter" ]; then
    echo "$HOME/snap/flutter/common/flutter/bin/flutter"
    return 0
  fi
  if command -v flutter >/dev/null 2>&1; then
    command -v flutter
    return 0
  fi
  return 1
}

frontend_start() {
  if is_container_env; then
    success "Ambiente Docker detectado: o Frontend Web já está pré-compilado e integrado ao Backend (porta 8000)."
    return 0
  fi
  local foreground=false
  local release=false
  for arg in "$@"; do
    if [[ "$arg" == "-f" || "$arg" == "--foreground" ]]; then
      foreground=true
    elif [[ "$arg" == "--release" ]]; then
      release=true
    fi
  done

  # Verificar se a porta 3000 já está em uso
  local existing_pid
  existing_pid=$(find_pid_by_port 3000)
  if [ -n "$existing_pid" ]; then
    warn "Frontend já parece estar ativo na porta 3000 (PID: $existing_pid)."
    return 0
  fi

  local flutter_bin
  flutter_bin=$(find_flutter_bin)
  if [ -z "$flutter_bin" ]; then
    error "SDK do Flutter não encontrado."
    return 1
  fi

  local run_args=("-d" "web-server" "--web-port=3000")
  if [ "$release" = true ]; then
    run_args+=("--release")
  fi

  if [ "$foreground" = true ]; then
    if [ "$release" = true ]; then
      info "Iniciando Flutter Web em modo RELEASE em primeiro plano na porta 3000 (Ctrl+C para encerrar)..."
    else
      info "Iniciando Flutter Web em primeiro plano na porta 3000..."
      info "Pressione 'r' para Hot Reload, 'R' para Hot Restart, 'q' para encerrar."
    fi
    cd "$PROJECT_ROOT/frontend" && "$flutter_bin" run "${run_args[@]}"
  else
    if [ "$release" = true ]; then
      info "Iniciando Flutter Web em modo RELEASE em segundo plano na porta 3000..."
      echo "1" > "$PID_DIR/frontend.release"
      cd "$PROJECT_ROOT/frontend"
      setsid "$flutter_bin" run "${run_args[@]}" < /dev/null > "$LOG_DIR/frontend.log" 2>&1 &
      local new_pid=$!
      echo "$new_pid" > "$PID_DIR/frontend.pid"
    else
      info "Iniciando Flutter Web em segundo plano na porta 3000..."
      rm -f "$PID_DIR/frontend.release"

      local fifo="$PID_DIR/frontend.pipe"
      rm -f "$fifo"
      mkfifo "$fifo"

      # Mantém o pipe aberto para escrita em segundo plano (evita EOF no stdin do flutter)
      tail -f /dev/null > "$fifo" &
      local pipe_holder_pid=$!
      echo "$pipe_holder_pid" > "$PID_DIR/frontend.pipe.pid"

      cd "$PROJECT_ROOT/frontend"
      setsid "$flutter_bin" run "${run_args[@]}" < "$fifo" > "$LOG_DIR/frontend.log" 2>&1 &
      local new_pid=$!
      echo "$new_pid" > "$PID_DIR/frontend.pid"
    fi

    sleep 2
    if is_pid_alive "$new_pid"; then
      if [ "$release" = true ]; then
        success "Frontend (RELEASE) inicializando em background (PID: $new_pid) → http://localhost:3000"
        info "A compilação em release pode levar alguns instantes. Acompanhe com: ridel frontend logs"
      else
        success "Frontend inicializando em background (PID: $new_pid) → http://localhost:3000"
        info "Aguarde a compilação inicial. Acompanhe com: ridel frontend logs"
      fi
    else
      error "Falha ao iniciar o Frontend. Verifique com: ridel frontend logs"
      return 1
    fi
  fi
}

frontend_stop() {
  local pid=""
  if [ -f "$PID_DIR/frontend.pid" ]; then
    pid=$(cat "$PID_DIR/frontend.pid")
  fi

  local port_pid
  port_pid=$(find_pid_by_port 3000)

  if [ -n "$pid" ]; then
    kill_process "Frontend (Flutter Web)" "$pid"
    rm -f "$PID_DIR/frontend.pid"
  fi

  if [ -n "$port_pid" ] && [ "$port_pid" != "$pid" ]; then
    kill_process "Processo residual na porta 3000" "$port_pid"
  fi

  # Encerra processo mantenedor do pipe se existir
  if [ -f "$PID_DIR/frontend.pipe.pid" ]; then
    local pipe_pid
    pipe_pid=$(cat "$PID_DIR/frontend.pipe.pid")
    kill_process "Pipe Holder" "$pipe_pid"
    rm -f "$PID_DIR/frontend.pipe.pid"
  fi
  rm -f "$PID_DIR/frontend.pipe"
  rm -f "$PID_DIR/frontend.release"

  # Garante encerramento de eventuais subprocessos Dart órfãos do flutter_tools
  pkill -f "flutter_tools.snapshot.*--web-port=3000" 2>/dev/null || true
  pkill -f "flutter.*--web-port=3000" 2>/dev/null || true

  if [ -z "$pid" ] && [ -z "$port_pid" ]; then
    info "Frontend não está em execução."
  fi
}

frontend_restart() {
  info "Reiniciando Frontend..."
  frontend_stop
  sleep 1
  frontend_start "$@"
}

frontend_release() {
  info "Alternando Frontend para modo RELEASE..."
  frontend_stop
  sleep 1
  frontend_start --release "$@"
}

frontend_reload() {
  local pid=""
  if [ -f "$PID_DIR/frontend.pid" ]; then
    pid=$(cat "$PID_DIR/frontend.pid")
  fi

  local port_pid
  port_pid=$(find_pid_by_port 3000)

  if (! is_pid_alive "$pid") && [ -z "$port_pid" ]; then
    warn "Frontend não está em execução. Inicie o frontend com: ridel frontend start"
    return 1
  fi

  local target_pid=""
  if is_pid_alive "$pid"; then
    target_pid="$pid"
  elif [ -n "$port_pid" ]; then
    target_pid="$port_pid"
  fi

  if [ -f "$PID_DIR/frontend.release" ] || ( [ -n "$target_pid" ] && grep -qa -- "--release" "/proc/$target_pid/cmdline" 2>/dev/null ); then
    warn "O Flutter Web está em execução em modo RELEASE. O modo RELEASE não suporta Hot Reload/Hot Restart dinâmico."
    info "Para utilizar Hot Reload, inicie o frontend em modo de desenvolvimento: ridel frontend start"
    return 1
  fi

  local fifo="$PID_DIR/frontend.pipe"
  if [ ! -p "$fifo" ]; then
    warn "Canal de comunicação (pipe) do frontend não encontrado em $fifo."
    info "Reinicie o frontend para habilitar o canal de reload: ridel frontend restart"
    return 1
  fi

  info "Enviando sinal de Hot Reload ('r') para o Flutter Web..."
  if timeout 2 bash -c "echo 'r' > '$fifo'" 2>/dev/null; then
    success "Hot Reload disparado com sucesso no Universal Player!"
    info "Acompanhe os logs em tempo real com: ridel frontend logs"
    return 0
  else
    error "Falha ao enviar sinal para o pipe do Flutter Web."
    return 1
  fi
}

